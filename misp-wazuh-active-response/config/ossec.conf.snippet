<!-- Add this under the <ossec_config> section in /var/ossec/etc/ossec.conf -->

<command>
  <name>misp-active-response</name>
  <executable>misp-ar.exe</executable>
  <timeout_allowed>yes</timeout_allowed>
</command>

<active-response>
  <command>misp-active-response</command>
  <location>local</location>
  <rules_id>200003</rules_id> <!-- Rule for domains -->
  <timeout>10</timeout>
</active-response>

<active-response>
  <command>misp-active-response</command>
  <location>local</location>
  <rules_id>200004</rules_id> <!-- Rule for SHA256 hashes -->
  <timeout>10</timeout>
</active-response>
